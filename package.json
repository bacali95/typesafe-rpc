{
  "name": "typesafe-rpc",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "build": "nx run-many -t build",
    "test": "nx run-many -t test --coverage",
    "lint": "nx run-many -t lint",
    "prettier:check": "nx format:check",
    "prettier:fix": "nx format:write",
    "release": "standard-version --path libs/typesafe-rpc",
    "release:rpc": "standard-version --path libs/typesafe-rpc",
    "release:ws": "standard-version --path libs/typesafe-ws --packageFiles libs/typesafe-ws/package.json --bumpFiles libs/typesafe-ws/package.json --infile libs/typesafe-ws/CHANGELOG.md --tag-prefix typesafe-ws-v --commit-all"
  },
  "private": true,
  "dependencies": {
    "rollup": "4.64.5",
    "tslib": "^2.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@nx/eslint": "23.3.0",
    "@nx/eslint-plugin": "23.3.0",
    "@nx/jest": "23.3.0",
    "@nx/js": "23.3.0",
    "@nx/rollup": "23.3.0",
    "@nx/workspace": "23.3.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "8.71.1",
    "@typescript-eslint/parser": "8.71.1",
    "@typescript-eslint/utils": "8.71.1",
    "babel-jest": "30.5.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-cypress": "7.0.2",
    "eslint-plugin-import": "2.32.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "jest-util": "30.5.1",
    "nx": "23.3.0",
    "prettier": "^3.9.10",
    "standard-version": "^9.5.0",
    "ts-jest": "29.4.14",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.58.0",
    "ws": "^8.22.0"
  },
  "standard-version": {
    "commitAll": true,
    "packageFiles": "libs/typesafe-rpc/package.json",
    "bumpFiles": "libs/typesafe-rpc/package.json",
    "path": "libs/typesafe-rpc"
  }
}
